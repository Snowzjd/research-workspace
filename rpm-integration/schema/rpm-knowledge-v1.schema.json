{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RPM Knowledge Read Interface v1",
  "oneOf": [
    {"$ref":"#/$defs/Snapshot"},
    {"$ref":"#/$defs/Unchanged"},
    {"$ref":"#/$defs/FileResolution"},
    {"$ref":"#/$defs/Error"}
  ],
  "$defs": {
    "Id":{"type":"string","pattern":"^[0-9a-f]{32}$"},
    "Revision":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "Timestamp":{"type":"string","format":"date-time"},
    "OptionalText":{"type":["string","null"]},
    "OptionalId":{"oneOf":[{"$ref":"#/$defs/Id"},{"type":"null"}]},
    "Status":{"enum":["declared","planned","historical","documented","verified"]},
    "FileStatus":{"enum":["Original","Working","Validated","Final","Archived",null]},
    "TaskStatus":{"enum":["todo","doing","done"]},
    "NodeType":{"enum":["project","direction","research_question","theoretical_model","method","design","literature","engineering_model","dataset","experiment","decision","conclusion","paper","patent","deliverable","source"]},
    "Task":{
      "type":"object","required":["id","title","status","depends_on"],
      "properties":{"id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},
          "status":{"$ref":"#/$defs/TaskStatus"},"depends_on":{"type":"array","items":{"type":"string"}}}
    },
    "Change":{
      "type":"object","required":["timestamp","message","rpm_token"],
      "properties":{"timestamp":{"$ref":"#/$defs/Timestamp"},"message":{"type":"string"},
          "rpm_token":{"$ref":"#/$defs/OptionalText"}}
    },
    "FileRef":{
      "type":"object","required":["id","file_id","rpm_source_id","title","project_id","path","relative_path","href","status","evidence","origin"],
      "properties":{
        "id":{"$ref":"#/$defs/Id"},"file_id":{"$ref":"#/$defs/OptionalId"},"rpm_source_id":{"$ref":"#/$defs/Id"},
        "title":{"type":"string"},"project_id":{"$ref":"#/$defs/Id"},"path":{"type":"string","minLength":1},
        "relative_path":{"type":"string","minLength":1},"href":{"type":"string","pattern":"^file:"},
        "status":{"$ref":"#/$defs/FileStatus"},"evidence":{"$ref":"#/$defs/OptionalText"},
        "origin":{"enum":["indexed_file","management_record"]}
      }
    },
    "FileRecord":{
      "type":"object","required":["id","file_id","project_id","name","relative_path","status","presence","openable","absolute_path","href","index_related_files","related_file_ids"],
      "properties":{
        "id":{"$ref":"#/$defs/Id"},"file_id":{"$ref":"#/$defs/Id"},"project_id":{"$ref":"#/$defs/Id"},
        "name":{"type":"string"},"relative_path":{"type":"string"},"status":{"$ref":"#/$defs/FileStatus"},
        "presence":{"type":"string"},"openable":{"type":"boolean"},"absolute_path":{"$ref":"#/$defs/OptionalText"},
        "href":{"$ref":"#/$defs/OptionalText"},"related_file_ids":{"type":"array","items":{"$ref":"#/$defs/Id"}},
        "index_related_files":{"type":"string"},"size":{"type":"string"},"mtime_ns":{"type":"string"},
        "file_type":{"type":"string"},"category":{"type":"string"},"purpose":{"type":"string"},"version":{"type":"string"},
        "confidence":{"type":"string"},"reason":{"type":"string"},"group":{"type":"string"},
        "sha256":{"type":"string"},"duplicate_of":{"type":"string"}
      }
    },
    "Claim":{
      "type":"object","required":["project_id","local_id","description","status","usage_context","method_usage","status_origin","source_files"],
      "properties":{
        "project_id":{"$ref":"#/$defs/Id"},"local_id":{"type":"string","minLength":1},
        "description":{"type":"string"},"status":{"$ref":"#/$defs/Status"},
        "usage_context":{"enum":["registered_method","literature_record","historical_record","planned_or_declared",null]},
        "method_usage":{"enum":["adopted","investigating","historical_candidate","literature_only","undecided",null]},
        "status_origin":{"enum":["descriptor","project_config","rpm_default","unspecified"]},
        "source_files":{"type":"array","items":{"$ref":"#/$defs/FileRef"},"minItems":1}
      }
    },
    "Node":{
      "type":"object","required":["id","type","title","project_id","project_ids","description","status","source_files"],
      "properties":{
        "id":{"$ref":"#/$defs/Id"},"type":{"$ref":"#/$defs/NodeType"},"title":{"type":"string"},
        "project_id":{"$ref":"#/$defs/Id"},"project_ids":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":1,"uniqueItems":true},
        "description":{"$ref":"#/$defs/OptionalText"},"status":{"$ref":"#/$defs/OptionalText"},
        "source_files":{"type":"array","items":{"$ref":"#/$defs/FileRef"}},
        "claims":{"type":"array","items":{"$ref":"#/$defs/Claim"},"minItems":1},"shared":{"type":"boolean"}
      }
    },
    "Edge":{
      "type":"object","required":["id","source","target","relation_type","evidence","evidence_items","evidence_sources","project_id","project_ids","origin"],
      "properties":{
        "id":{"$ref":"#/$defs/Id"},"source":{"$ref":"#/$defs/Id"},"target":{"$ref":"#/$defs/Id"},
        "relation_type":{"type":"string","minLength":1},"evidence":{"type":"string","minLength":1},
        "evidence_items":{"type":"array","items":{"type":"string"},"minItems":1},
        "evidence_sources":{"type":"array","items":{"$ref":"#/$defs/FileRef"}},
        "project_id":{"$ref":"#/$defs/Id"},"project_ids":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":1},
        "origin":{"enum":["index_membership","project_membership","knowledge_citation","research_relation","file_relation"]}
      }
    },
    "Project":{
      "type":"object","required":["id","title","root","types","direction","status","stage","description","status_note","tasks","changes","change_log_markdown","files","deliverables","file_summary"],
      "properties":{
        "id":{"$ref":"#/$defs/Id"},"title":{"type":"string"},"root":{"type":"string"},"types":{"type":"array","items":{"type":"string"}},
        "direction":{"$ref":"#/$defs/OptionalText"},"status":{"$ref":"#/$defs/OptionalText"},"stage":{"$ref":"#/$defs/OptionalText"},
        "description":{"$ref":"#/$defs/OptionalText"},"status_note":{"type":"string"},
        "tasks":{"type":"array","items":{"$ref":"#/$defs/Task"}},"changes":{"type":"array","items":{"$ref":"#/$defs/Change"}},
        "change_log_markdown":{"type":"string"},"files":{"type":"array","items":{"$ref":"#/$defs/Id"}},
        "deliverables":{"type":"array","items":{"$ref":"#/$defs/Id"}},
        "file_summary":{"type":"object","required":["total","openable","by_presence","by_status"],
          "properties":{"total":{"type":"integer","minimum":0},"openable":{"type":"integer","minimum":0},
            "by_presence":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
            "by_status":{"type":"object","additionalProperties":{"type":"integer","minimum":0}}}}
      }
    },
    "Issue":{
      "type":"object","required":["code","message","item"],"properties":{
        "code":{"type":"string"},"message":{"type":"string"},"item":{"$ref":"#/$defs/OptionalText"},
        "project_id":{"$ref":"#/$defs/Id"},"project_ids":{"type":"array","items":{"$ref":"#/$defs/Id"}}
      }
    },
    "Header":{
      "type":"object","required":["ok","schema_version","revision","generated_at","data_updated_at","not_modified","scope","registry_complete"],
      "properties":{
        "ok":{"const":true},"schema_version":{"const":1},"revision":{"$ref":"#/$defs/Revision"},
        "generated_at":{"$ref":"#/$defs/Timestamp"},"data_updated_at":{"oneOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},
        "not_modified":{"type":"boolean"},"scope":{"$ref":"#/$defs/OptionalId"},"registry_complete":{"type":"boolean"}
      }
    },
    "Snapshot":{
      "allOf":[{"$ref":"#/$defs/Header"},{"required":["projects","files","nodes","edges","issues"],"properties":{
        "not_modified":{"const":false},"projects":{"type":"array","items":{"$ref":"#/$defs/Project"}},
        "files":{"type":"array","items":{"$ref":"#/$defs/FileRecord"}},"nodes":{"type":"array","items":{"$ref":"#/$defs/Node"}},
        "edges":{"type":"array","items":{"$ref":"#/$defs/Edge"}},"issues":{"type":"array","items":{"$ref":"#/$defs/Issue"}}
      }}]
    },
    "Unchanged":{"allOf":[{"$ref":"#/$defs/Header"},{"properties":{"not_modified":{"const":true}}}]},
    "FileResolution":{"type":"object","required":["ok","schema_version","project_id","file","revision"],"properties":{
      "ok":{"const":true},"schema_version":{"const":1},"project_id":{"$ref":"#/$defs/Id"},
      "file":{"$ref":"#/$defs/FileRef"},"revision":{"$ref":"#/$defs/Revision"}
    }},
    "Error":{"type":"object","required":["ok","schema_version","code","error"],"properties":{
      "ok":{"const":false},"schema_version":{"const":1},"code":{"type":"string","minLength":1},"error":{"type":"string","minLength":1}
    }}
  }
}
